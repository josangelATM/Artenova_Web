generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  nuevo
  pendiente_diseno
  pendiente_aprobacion
  pendiente_fabricacion
  pendiente_imprimir
  listo_entrega
  entregado
}

enum OrderSource {
  storefront
  admin_manual
}

enum OrderPaymentMethod {
  efectivo
  yappy
  transferencia
  otro
}

enum ExpenseCategory {
  materia_prima
  servicios
  publicidad
  salario
  viaticos
  otros
}

enum ExpensePaymentMethod {
  efectivo
  yappy
  transferencia
  tarjeta_credito
  otro
}

enum QRCodeType {
  url
  whatsapp
  vcard
}

enum QRCodeStatus {
  active
  inactive
}

enum CustomFieldType {
  text
  date
  select
  image
  note
}

enum DiscountType {
  percentage
  fixed
}

enum ProductMediaType {
  image
  video
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  accentColor String?
  currencySymbol String @default("B/.")
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  sku          String?       @unique
  defaultVariantId String?       @unique
  description  String
  basePrice    Decimal       @db.Decimal(10, 2)
  discountType DiscountType?
  discountValue Decimal?     @db.Decimal(10, 2)
  isPublished  Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  isHero        Boolean       @default(false)
  heroSlot      String?
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultVariant ProductVariant? @relation("ProductDefaultVariant", fields: [defaultVariantId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  priceTiers   PriceTier[]
  options      ProductOption[]
  variants     ProductVariant[] @relation("ProductVariants")
  extras       ProductExtra[]
  customFields CustomField[]
  reviews      ProductReview[]
  orderItems   OrderItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProductVariant {
  id            String                    @id @default(cuid())
  productId     String
  product       Product                   @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)
  defaultForProduct Product?              @relation("ProductDefaultVariant")
  name          String
  sku           String?
  selectionKey  String?
  visualGroupKey String?
  basePrice     Decimal                   @db.Decimal(10, 2)
  discountType  DiscountType?
  discountValue Decimal?                  @db.Decimal(10, 2)
  isActive      Boolean                   @default(true)
  position      Int                       @default(0)
  images        ProductVariantImage[]
  attributes    ProductVariantAttribute[]
  optionValues  ProductVariantOptionValue[]
  priceTiers    PriceTier[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([productId, position])
  @@index([productId, selectionKey])
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  drivesVisualGroup Boolean      @default(false)
  position  Int                  @default(0)
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([productId, position])
}

model ProductOptionValue {
  id         String                     @id @default(cuid())
  optionId    String
  option      ProductOption             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value       String
  position    Int                       @default(0)
  swatch      String?
  variants    ProductVariantOptionValue[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([optionId, position])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  type      ProductMediaType @default(image)
  alt       String
  position  Int            @default(0)
  posterUrl String?
  createdAt DateTime       @default(now())
}

model ProductVariantAttribute {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  value     String
  position  Int            @default(0)
  createdAt DateTime       @default(now())
}

enum ProductReviewSource {
  customer
  admin
}

model ProductReview {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating       Int
  customerName String
  comment      String
  isApproved   Boolean             @default(true)
  source       ProductReviewSource @default(customer)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([productId, isApproved, createdAt])
  @@index([isApproved, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      ProductMediaType @default(image)
  alt       String
  position  Int      @default(0)
  posterUrl String?
  createdAt DateTime @default(now())
}

model PriceTier {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQuantity Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal? @db.Decimal(10, 2)
  label       String?
  createdAt   DateTime @default(now())
}

model ProductExtra {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  type       String
  priceDelta Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
}

model CustomField {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  type      CustomFieldType
  required  Boolean         @default(false)
  options   Json            @default("[]")
  helpText  String?
  position  Int             @default(0)
  createdAt DateTime        @default(now())
}

model Order {
  id               String        @id @default(cuid())
  code             String        @unique
  source           OrderSource   @default(storefront)
  status           OrderStatus   @default(nuevo)
  customerName     String
  customerWhatsapp String
  customerNote     String?
  estimatedTotal   Decimal       @db.Decimal(10, 2)
  finalPrice       Decimal?      @db.Decimal(10, 2)
  adminNote        String?
  internalNote     String?
  completedAt      DateTime?
  items            OrderItem[]
  payments         OrderPayment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String
  quantity         Int
  unitPrice        Decimal       @db.Decimal(10, 2)
  extrasTotal      Decimal       @db.Decimal(10, 2)
  lineTotal        Decimal       @db.Decimal(10, 2)
  skuSnapshot      String?
  variantNameSnapshot String?
  unitLabel        String?
  selectedExtraIds Json          @default("[]")
  appliedAdjustments Json        @default("[]")
  personalization  Json          @default("{}")
  isDone           Boolean       @default(false)
  units            OrderItemUnit[]
}

model OrderItemUnit {
  id             String    @id @default(cuid())
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  position        Int       @default(0)
  label           String?
  personalization Json      @default("{}")
  createdAt       DateTime  @default(now())

  @@index([orderItemId, position])
}

model OrderPayment {
  id         String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Decimal            @db.Decimal(10, 2)
  method      OrderPaymentMethod @default(otro)
  reference   String?
  note        String?
  createdAt   DateTime           @default(now())

  @@index([orderId, createdAt])
}

model Expense {
  id            String               @id @default(cuid())
  category      ExpenseCategory
  amount        Decimal              @db.Decimal(10, 2)
  expenseDate   DateTime
  description   String
  paymentMethod ExpensePaymentMethod?
  reference     String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([expenseDate, createdAt])
  @@index([category, expenseDate])
}

model SiteSettings {
  id          String   @id @default("site")
  brandName   String   @default("Artenova")
  heroTitle   String
  heroSubtitle String
  whatsapp    String
  email       String?
  address     String
  businessHours String?
  mapsUrl     String?
  personalizationNotice String?
  bannerText  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QRCode {
  id                String       @id @default(cuid())
  name              String
  token             String       @unique
  type              QRCodeType
  status            QRCodeStatus @default(active)
  destinationConfig Json
  designConfig      Json
  scanCount         Int          @default(0)
  lastScannedAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}
